{
  "name": "octopal",
  "productName": "Octopal",
  "version": "0.1.56",
  "description": "Chat with your .octo agents. Load a folder, talk to agents in a group room.",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cargo tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "node scripts/tauri-build.mjs",
    "build:signed": "node scripts/tauri-build.mjs",
    "dev:renderer": "vite --config renderer/vite.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "check": "tsc --noEmit -p renderer/tsconfig.json && vitest run",
    "audit:dependencies": "pnpm audit --audit-level=low",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/diff": "^5.2.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2",
    "border-beam": "^1.3.0",
    "canvas-confetti": "^1.9.4",
    "diff": "^5.2.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  }
}
